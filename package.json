{
  "name": "ipsycho",
  "version": "1.0.0-rc.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "tsc -p tsconfig.json",
    "dev": "bash scripts/dev.sh",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/database/migrate.ts",
    "admin": "tsx src/cli.ts",
    "test:core": "rm -rf .core-dist && tsc -p tsconfig.core.json && node --test tests/core/*.test.mjs",
    "test:app": "npm run build && node --test tests/app/*.test.mjs",
    "test:e2e": "sh scripts/test-e2e.sh",
    "eval:agent": "npm run build && node scripts/eval-agent.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:core && npm run test:app",
    "lint": "eslint src tests scripts --max-warnings=0",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,mjs,json}\"",
    "coverage": "npm run build && c8 node --test tests/core/*.test.mjs tests/app/*.test.mjs"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@grammyjs/runner": "2.0.3",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "dotenv": "16.4.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "1.46.0",
    "openai": "7.10.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.69.0"
  }
}
