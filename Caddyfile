# IPsycho edge proxy — the only part of the deployment reachable from the internet.
#
# Two rules decide almost everything in this file, and both have a specific failure mode:
#
#   1. There is no catch-all `reverse_proxy`. Caddy answers a path that matches no route with an
#      empty 200, so a catch-all would publish `/health` and `/ready`, which report the commit SHA,
#      the database state and the names of the periodic loops. Only `/app*` and `/api/v1/*` are
#      proxied; the final `handle` answers 404.
#   2. There is no `X-Frame-Options`. Telegram Web opens Mini Apps in an iframe, `DENY` makes the
#      app a blank page there, and the obvious fix under pressure is deleting the whole CSP with it.
#      Framing is restricted by `frame-ancestors` instead, and `script-src` stays free of
#      `'unsafe-inline'`: the API is same-origin with no cookie, so an XSS here is account control.
#
# The domain is deliberately not baked in. `WEBAPP_DOMAIN` and `ACME_EMAIL` come from the compose
# environment, which reads `/opt/ipsycho/.env`. Choosing the domain, pointing DNS at the VPS and
# issuing the certificate are manual steps in docs/DEPLOYMENT.md § "Mini App: domain, TLS and
# registration". Both are required together: with either one empty Caddy refuses to start with a
# config error, which is the intended loud failure rather than a silent default domain.
{
	# The admin API is an unauthenticated config-write socket on 2019. Nothing here uses it.
	admin off
	email {$ACME_EMAIL}

	# No `servers { trusted_proxies … }` on purpose. Caddy is the edge, so it must trust no
	# client-supplied `X-Forwarded-For` or `Forwarded` header when it decides the client IP.
	# Caddy's default is to trust none; the `header_up` line in each `reverse_proxy` below then
	# *replaces* the header sent upstream with the address Caddy actually saw, so the app's IP
	# rate limiter cannot be steered or filled by an unauthenticated client. See design.md § 8.
}

(hardening) {
	header {
		# No `preload`: that directive is a submission to a browser-vendor list covering the
		# whole registrable domain, which is not this subdomain's decision to make.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
		-X-Powered-By
	}
}

(to_app) {
	reverse_proxy app:3000 {
		# Replace, never append: an incoming `X-Forwarded-For: 1.2.3.4` must not survive.
		# `{client_ip}` adapts to `{http.vars.client_ip}`, the trusted-proxy-aware client
		# address. The long form `{http.request.client_ip}` is NOT a registered placeholder:
		# Caddy forwards it to the app as that literal string, silently, and the IP rate
		# limiter then keys every request on the same value. Verified against caddy:2-alpine.
		header_up X-Forwarded-For {client_ip}
		header_up -X-Real-IP
		header_up -Forwarded
	}
}

{$WEBAPP_DOMAIN} {
	import hardening

	# Access logs off. Every API request carries `Authorization: tma <initDataRaw>`, which is a
	# bearer credential for the whole account, and a request log is the easiest place to leak it.
	# The app already logs `{ requestId, userId }` with the internal uuid. To turn logging on for
	# an investigation, replace this block with the filtered form in docs/DEPLOYMENT.md.
	log {
		output discard
	}

	# Hashed asset filenames, so the content at a URL never changes. Nest sets the same header;
	# stating it at the edge means a mistake on one side cannot produce a stale-forever index.
	# This assumes Vite's default `assetsDir`; if `web/vite.config.ts` renames it the assets fall
	# through to the block below and are merely uncached, never stale.
	@app_assets path /app/assets/*
	handle @app_assets {
		header >Cache-Control "public, max-age=31536000, immutable"
		import to_app
	}

	# `/app` and everything under it, and nothing else. Not `/app*`: that also matches `/apple`,
	# which the app answers with Nest's own 404 — a body that quotes the requested path back. An
	# unmatched path must be refused at the edge, by the `handle` at the bottom of this block.
	@app path /app /app/*
	handle @app {
		# `index.html` names the current asset hashes, so it must never be cached. `>` replaces the
		# header rather than adding to it: Nest sets the same value on what it serves, and two
		# identical `Cache-Control` lines are one header a proxy or a browser may read either way.
		header >Cache-Control "no-store"
		# `default-src 'none'` means every fetch kind the bundle uses has to be listed here. If it
		# starts loading self-hosted fonts or a web manifest, add `font-src 'self'` or
		# `manifest-src 'self'`. Do not widen `script-src`, and do not delete the policy.
		header Content-Security-Policy "default-src 'none'; script-src 'self' https://telegram.org; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-ancestors https://web.telegram.org https://*.telegram.org; base-uri 'none'; form-action 'none'"
		import to_app
	}

	handle /api/v1/* {
		# Mirrors the 64 KB JSON body limit in `main.ts`, so an oversized body is dropped at the
		# edge instead of being buffered by the single app process.
		request_body {
			max_size 64KB
		}
		header >Cache-Control "no-store"
		import to_app
	}

	# Everything else, `/health` and `/ready` included. No body: an unmatched path should not say
	# whether it exists.
	handle {
		respond 404
	}
}
