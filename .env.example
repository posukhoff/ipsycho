NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://ipsycho:replace_me@localhost:5432/ipsycho
POSTGRES_PASSWORD=replace_with_long_random_password
TELEGRAM_BOT_TOKEN=replace_me
BOT_IDENTITY=ipsycho-main
# Optional: receives owner-side AI spend warnings.
# OWNER_TELEGRAM_USER_ID=123456789

# Choose exactly one provider. When changing provider, also set a compatible AI_MODEL.
AI_PROVIDER=openai
AI_MODEL=replace_with_provider_model_id
# Optional deeper model for analysis topics / weekly reviews. If omitted, AI_MODEL is reused.
# AI_MODEL_DEEP=replace_with_optional_deeper_model_id
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_VOICE_MAX_DURATION_SECONDS=300
AI_VOICE_MAX_BYTES=20971520
AI_CONSENT_VERSION=2026-08-voice
AI_MAX_MESSAGES_PER_HOUR=60
AI_MAX_CALLS_PER_HOUR=60
# Optional. Monthly AI spend in USD at which the user and the owner get a warning; needs AI_PRICING_JSON.
# AI_MONTHLY_WARNING_USD=10
# Default off. Enable only after migration 0022 and staged QA succeed.
# Optional. Keep prices operator-managed; model IDs/prices are intentionally not frozen in code.
# AI_PRICING_JSON={"your-text-model":{"inputUsdPerMillion":0.0,"outputUsdPerMillion":0.0,"revision":"YYYY-MM-DD"},"gpt-4o-mini-transcribe":{"audioUsdPerMinute":0.0,"revision":"YYYY-MM-DD"}}

# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...
